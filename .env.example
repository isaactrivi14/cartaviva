# Copia este archivo como .env (iniciar.bat lo hace solo la primera vez).
# NUNCA subas el archivo .env a GitHub.

# En tu portátil: True. En producción: False.
DEBUG=True
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Solo en producción (con DEBUG=False):
#   CSRF_TRUSTED_ORIGINS=https://tu-dominio
#   SECURE_SSL_REDIRECT=True     -> manda todo a HTTPS
#   SECURE_HSTS_SECONDS=3600     -> subirlo a 31536000 cuando HTTPS ya funcione bien

# Base de datos:
#   sqlite -> funciona sin instalar nada (ideal para probar la demo)
#   mysql  -> la que exige la guía; llena los datos de abajo
DB_ENGINE=sqlite
DB_NAME=cartaviva
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
